{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "frontend-config.schema.json",
  "title": "Frontend runtime configuration (/config.json)",
  "description": "Written by the frontend container at start from APP_WORKSHOPS (docs/02_specification.md 3.6, AR-04).",
  "type": "object",
  "additionalProperties": false,
  "required": ["workshops"],
  "properties": {
    "workshops": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 20 },
          "name": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
