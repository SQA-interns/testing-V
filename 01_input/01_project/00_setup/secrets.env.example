# Every secret, key, account or external service credential the project needs.
# Owner: Architect. Read in: phase 0. Agent: read-only.
# The human copies this file to .env (ignored by git) and fills the values; the agent checks .env in phase 0.

# PostgreSQL password for the application user; local, production; provided
POSTGRES_PASSWORD=

# Organizer login (password: random, at least 16 characters); local, production; provided
ORGANIZER_USERNAME=
ORGANIZER_PASSWORD=

# External SMTP account; production; not needed (local and tests use Mailpit)
SMTP_USERNAME=
SMTP_PASSWORD=

# NVD API key for OWASP Dependency-Check; local (phase 0 and phase 6 scans); provided
NVD_API_KEY=
